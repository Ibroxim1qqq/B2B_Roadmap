# Ilova nomi
NEXT_PUBLIC_APP_NAME="Samarqand Qurilish Xaritasi"

# Bepul AI sozlamalari (ixtiyoriy, kalitsiz ham o'rnatilgan aqlli algoritmlar bilan ishlaydi)
